// ===========================================================================
// MIC Event — database schema
// ===========================================================================
// Four tables, one job each: who people are, what is happening, who signed up,
// and who actually walked in.
//
// The constraints below are the ones the hard requirements depend on, so they
// are worth reading before the code:
//
//   Registration @@unique([eventId, userId]) — one registration per person per
//     event, enforced by Postgres rather than by an application check.
//   Registration.qrToken @unique            — the opaque value inside the QR;
//     looking a ticket up is an indexed single-row read.
//   CheckIn.registrationId @unique          — a registration can produce at
//     most one check-in. A second scan fails the insert; the handler turns
//     that failure into "already checked in", which is what makes duplicate
//     protection correct even with several server processes on one database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ORGANIZER
  ATTENDEE
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())

  organizedEvents Event[]        @relation("EventOrganizer")
  registrations   Registration[]
}

model Event {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  venue       String
  startsAt    DateTime
  endsAt      DateTime
  capacity    Int
  organizerId String
  createdAt   DateTime @default(now())

  organizer     User           @relation("EventOrganizer", fields: [organizerId], references: [id])
  registrations Registration[]

  @@index([organizerId])
  @@index([startsAt])
}

model Registration {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  /// Opaque, cryptographically random. Carries no personal data — it is only
  /// a lookup key, so a leaked QR image reveals nothing about its owner.
  qrToken   String   @unique
  createdAt DateTime @default(now())

  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkIn CheckIn?

  @@unique([eventId, userId])
  @@index([eventId])
}

model CheckIn {
  id             String   @id @default(cuid())
  registrationId String   @unique
  checkedInAt    DateTime @default(now())
  /// Which scanner recorded it — useful once several doors scan at once.
  stationId      String?
  /// Set by the scanner device before the scan is sent. Unique, so replaying a
  /// queued offline scan can never insert a second row: the retry either finds
  /// its own earlier write or loses the race and is reported as a duplicate.
  clientScanId   String?  @unique

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
}
