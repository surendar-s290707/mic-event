# ---------------------------------------------------------------------------
# MIC Event — environment configuration
# Copy to .env and adjust.  .env is git-ignored; never commit real secrets.
# ---------------------------------------------------------------------------

# --- Server (read by server/src/env.ts) ---
PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call the API.
# Leave empty in development (the Vite dev server proxies /api, so no CORS needed).
CORS_ORIGIN=http://localhost:5173

# --- Not used yet — reserved for the next milestones -----------------------
# Milestone 2 (PostgreSQL + Prisma)
# DATABASE_URL=postgresql://user:password@localhost:5432/mic_event

# Milestone 3 (real auth)
# JWT_SECRET=replace-me

# Milestone 5 (server-side AI insights; key must stay server-side)
# ANTHROPIC_API_KEY=

# --- Client (Vite: only VITE_* vars reach the browser) ---------------------
# Leave unset in development — the dev server proxies /api to PORT above.
# In production set this to the deployed API origin, e.g. https://api.example.com
# VITE_API_BASE_URL=
