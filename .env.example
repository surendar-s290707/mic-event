# ---------------------------------------------------------------------------
# MIC Event — environment configuration
# Copy to .env and adjust:  cp .env.example .env
# .env is git-ignored. Never commit real credentials or secrets.
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------
PORT=4000

# NODE_ENV is deliberately NOT set here.
# Vite reads this same .env when it builds the client, and NODE_ENV=development
# in it produces a development React build — larger, slower, and full of dev
# warnings. Set NODE_ENV in the process environment instead: `npm run dev`
# leaves it unset (development is the server's default) and `npm run start:prod`
# sets it to production.

# Comma-separated list of browser origins allowed to call the API.
# Development needs no entry: Vite proxies /api, so it is same-origin.
# Production: set this to the site's origin, e.g. https://mic-event.example.com
CORS_ORIGIN=http://localhost:5173

# --- Database (required) ----------------------------------------------------
# Matches docker-compose.yml, which runs Postgres locally for development.
#   npm run db:up      start the database
#   npm run db:migrate apply migrations
#   npm run db:seed    load demo data (deletes existing rows)
DATABASE_URL=postgresql://mic:mic@localhost:5432/mic_event

# Separate database used by `npm test`. The suite wipes it between runs, so it
# must never point at a database with real data.
TEST_DATABASE_URL=postgresql://mic:mic@localhost:5432/mic_event_test

# --- Authentication (required) ----------------------------------------------
# Signs the session JWT that is stored in an HTTP-only cookie.
# Generate your own:  openssl rand -hex 32
# Changing it logs everyone out. Never commit the real value.
JWT_SECRET=replace-me-with-openssl-rand-hex-32

# How long a session lasts.
SESSION_TTL_DAYS=7

# --- Reserved for later milestones -----------------------------------------
# Server-side AI insights; the key must never reach the browser.
# ANTHROPIC_API_KEY=

# --- Client (Vite: only VITE_* variables reach the browser) -----------------
# Dev proxy target — only needed if the API is not on http://127.0.0.1:4000.
# VITE_DEV_API_TARGET=http://127.0.0.1:4000

# Production API origin. Leave unset when the API serves the client itself.
# VITE_API_BASE_URL=
